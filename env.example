# Copy this file to `.env` and填入實際資訊
DISCORD_TOKEN=your_discord_bot_token
N8N_WEBHOOK_URL=http://localhost:5678/webhook/discord-shopping
ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
GROQ_API_KEY=your_groq_api_key

# 選填：改用其他 Groq 模型（預設 openai/gpt-oss-120b）
# GROQ_MODEL=qwen/qwen3.6-27b

# 選填：只有這些 Discord user ID 能結單，逗號分隔
# 留空＝任何人都能結單（仍需按 ✅ 二次確認）
ORDER_MANAGER_IDS=
