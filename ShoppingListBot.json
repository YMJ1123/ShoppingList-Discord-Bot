      "name": "Respond (added)1"
    },
    {
      "parameters": {
        "jsCode": "// 在使用者自己加入的列中，用網址或商品名稱找出要刪除的那一筆\nconst req = $('Code').first().json;\nconst norm = (s) => (s ?? '').toString().trim().toLowerCase();\n\nconst collect = (nodeName, sheet) => {\n  let items = [];\n  try {\n    items = $(nodeName).all();\n  } catch (e) {\n    return [];\n  }\n  const seen = new Set();\n  const out = [];\n  for (const it of items) {\n    const r = it.json || {};\n    if (r.row_number === undefined || r.row_number === null || r.row_number === '') continue;\n    if (seen.has(r.row_number)) continue; // executeOnce 保險用：去除重複列\n    seen.add(r.row_number);\n    out.push({ ...r, _sheet: sheet });\n  }\n  return out;\n};\n\nconst candidates = [\n  ...collect('Get rows in sheet TB', 'TB'),\n  ...collect('Get rows in sheet JD', 'JD'),\n];\n\nlet match = null;\n\n// 1) 有網址就先用網址精確比對\nconst url = norm(req.url);\nif (url) {\n  match = candidates.find((r) => norm(r['商品網址']) === url) || null;\n}\n\n// 2) 沒中再用商品名稱：先完全相同，再互相包含（模糊比對）\nif (!match && req.itemName) {\n  const q = norm(req.itemName);\n  match =\n    candidates.find((r) => norm(r['預購買商品']) === q) ||\n    candidates.find((r) => norm(r['預購買商品']).includes(q)) ||\n    candidates.find((r) => {\n      const name = norm(r['預購買商品']);\n      return name && q.includes(name);\n    }) ||\n    null;\n}\n\nif (!match) {\n  return [{ json: { found: false } }];\n}\n\nreturn [\n  {\n    json: {\n      found: true,\n      sheet: match._sheet,\n      row_number: match.row_number,\n      itemName: match['預購買商品'] || '',\n    },\n  },\n];\n"
      },
