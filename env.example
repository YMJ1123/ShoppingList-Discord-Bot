# Copy this file to `.env` and填入實際資訊
DISCORD_TOKEN=your_discord_bot_token
ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
GROQ_API_KEY=your_groq_api_key
SHEET_ID=your_google_spreadsheet_id
# OAuth JSON 檔案，內含 client_id、client_secret、refresh_token；放在 repo 外並限制為擁有者可讀寫
# Docker 部署時以唯讀方式掛載到這個路徑
GOOGLE_CREDENTIALS=/run/secrets/google-oauth.json

# --- 以下選填 ---
# GROQ_MODEL=openai/gpt-oss-120b
# 結算時讀截圖：先用指定的本地模型，太慢、失敗或讀不完整時會把截圖送到 Groq 後備模型
# VISION_MODEL=qwen/qwen3.8-27b
# LOCAL_VISION_URL=http://localhost:11434/v1
# LOCAL_VISION_MODEL=qwen3-vl:8b-instruct
# LOCAL_VISION_TIMEOUT=45
# 本機結算快取；完整狀態與結算明細也會寫入 Google 試算表
# STATE_DIR=./data
