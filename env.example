# Copy this file to `.env` and填入實際資訊
DISCORD_TOKEN=your_discord_bot_token
N8N_WEBHOOK_URL=http://localhost:5678/webhook/discord-shopping
ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
GROQ_API_KEY=your_groq_api_key

# --- 以下選填 ---
# GROQ_MODEL=openai/gpt-oss-120b
# 結算時讀截圖的視覺模型；設 VISION_BASE_URL 可改用本地 Ollama 等 OpenAI 相容服務
# VISION_MODEL=qwen/qwen3.8-27b
# VISION_BASE_URL=http://localhost:11434/v1
# 存結算紀錄的資料夾（有設的話重啟後還能認領）
# STATE_DIR=./data
